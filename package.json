{
  "name": "psepho-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @psepho/web dev",
    "dev:mobile": "pnpm --filter @psepho/mobile dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "cdk:synth": "pnpm --filter @psepho/infra cdk:synth",
    "cdk:diff": "pnpm --filter @psepho/infra cdk:diff",
    "cdk:deploy:dev": "pnpm --filter @psepho/infra deploy:dev",
    "cdk:deploy:prod": "pnpm --filter @psepho/infra deploy:prod"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.16.0"
}
