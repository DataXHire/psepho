{
  "name": "@psepho/infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK Infrastructure for Psepho on AWS Amplify and Amazon RDS",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff",
    "deploy:dev": "cdk deploy --all -c stage=dev",
    "deploy:prod": "cdk deploy --all -c stage=prod",
    "destroy:dev": "cdk destroy --all -c stage=dev"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "aws-cdk": "^2.180.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
