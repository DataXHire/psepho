# Database connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/psepho"

# Server-side pepper for hashing IP and User-Agent fingerprints (never raw IP)
SERVER_PEPPER="psepho-development-secret-pepper-do-not-use-in-production"

# Web application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Port
PORT=3000
