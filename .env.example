# ==============================================================================
# Psepho Environment Configuration Template (.env.example)
#
# Copy this file to .env.local for local development.
# In production, inject these variables via your cloud secrets manager
# (AWS Secrets Manager, Vercel Environment Variables, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 15+)
# ------------------------------------------------------------------------------
# In development: Direct local Postgres connection.
# In production: Use a pooled connection string (transaction mode) e.g., Neon,
# Supabase PgBouncer (port 6543), or AWS RDS Proxy (port 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/psepho"

# Optional: Direct unpooled connection for running DDL schema migrations in CI/CD.
# Required if your primary DATABASE_URL points to PgBouncer in transaction mode.
# DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/psepho?sslmode=require"

# Optional: Explicit SSL toggle for database connection ('true' or 'false').
# DATABASE_SSL="false"

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & Zero Raw IP Invariant
# ------------------------------------------------------------------------------
# Server-side secret pepper for hashing client IP and User-Agent fingerprints.
# Raw IP addresses are NEVER persisted to database or logs.
#
# LOCAL DEV: You may use the development fallback below.
# PRODUCTION WARNING: MUST be replaced with a secure 256-bit CSPRNG hex string!
# Generate with: openssl rand -hex 32
SERVER_PEPPER="psepho-development-secret-pepper-do-not-use-in-production"

# ------------------------------------------------------------------------------
# 3. Application & Networking URLs
# ------------------------------------------------------------------------------
# The canonical public URL where the web application is hosted.
# Used for generating QR codes, voting receipt verification links, and OpenGraph meta tags.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Port on which Next.js server listens (defaults to 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 4. Authentication (Google Identity Services / OAuth 2.0)
# ------------------------------------------------------------------------------
# Client ID obtained from Google Cloud Console -> APIs & Services -> Credentials.
# Must be configured with authorized JavaScript origins (e.g. http://localhost:3000, https://psepho.org)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Google OAuth client secret. Used by the server for backend token verification.
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 5. Runtime Environment
# ------------------------------------------------------------------------------
# Set to 'production' in deployed environments.
# NODE_ENV='production' activates Dead-Code Elimination (DCE), removing sample
# personas and development mode switches from client bundles.
# NODE_ENV="development"
